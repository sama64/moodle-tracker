[Unit]
Description=Moodle Tracker stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=sam
Group=sam
WorkingDirectory=/home/sam/services/moodle-tracker
ExecStart=/usr/bin/docker compose up -d --wait
ExecReload=/usr/bin/docker compose up -d --build --wait
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
